// Cloudflare Worker for docs.flokicoin.org: static assets only, no server code.
// A release Worker, built from a release tag (`yarn build` → build/). Routes, names
// and secrets live in docs/cloudflare.yaml of the deploys area's deploy repo, not here;
// .chabka/outside.yaml says what goes in the release.
{
  "name": "docs",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./build",
    // Docusaurus builds /x/index.html (trailingSlash: true) and a 404.html:
    // no SPA fallback, a missing path is a real 404 (as the Caddyfile does).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
